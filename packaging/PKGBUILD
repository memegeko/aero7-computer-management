pkgname=aero7-computer-management-git
pkgver=0.2.0.r7.ge5e0094
pkgrel=1
pkgdesc='Aero7-native Computer Management console for Linux'
arch=('x86_64')
url='https://github.com/memegeko/aero7-computer-management'
license=('MIT')
depends=('qt6-base' 'systemd' 'udisks2' 'polkit' 'shadow' 'dosfstools' 'e2fsprogs')
makedepends=('cmake' 'ninja' 'git')
optdepends=('samba: Shared Folders status'
            'linux-devmgmt: Device Manager integration'
            'ntfs-3g: create and extend NTFS volumes'
            'exfatprogs: create exFAT volumes'
            'btrfs-progs: create and extend Btrfs volumes'
            'xfsprogs: create and extend XFS volumes')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/aero7-computer-management"
  printf '0.2.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cmake -S "$srcdir/aero7-computer-management" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$srcdir/aero7-computer-management/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
